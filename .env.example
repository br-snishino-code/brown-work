# Vercel / ローカル開発の両方で、この2つだけを設定してください。
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 注意：
# SUPABASE_SERVICE_ROLE_KEY は絶対にここ（フロントエンド用の.env）や
# Vercelの環境変数に設定しないでください。
# service_role キーは supabase/functions/create-employee 用の
# Edge Function シークレットとしてのみ設定します。
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=xxxxx
